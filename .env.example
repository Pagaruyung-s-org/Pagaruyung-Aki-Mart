# URL Project Supabase Anda
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Anon Key (Public Key) - Boleh diexpose ke client
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role Key (Secret Key) - DILARANG DIEKSPOS KE CLIENT (Jangan gunakan prefix NEXT_PUBLIC_)
# Key ini membypass Row Level Security (RLS). Hanya gunakan di API Routes atau Server Components.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
